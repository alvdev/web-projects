{
    "name": "diario.games",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "echo 'VITE_SERVER=http://localhost:5173' > .dev && concurrently -n vite,php -c cyan,green \"vite\" \"php -S localhost:8899 kirby/router.php\"; rm -f .dev",
        "build": "vite build",
        "preview": "vite preview",
        "test:unit": "vitest run",
        "test": "bun run test:unit && composer test",
        "test:e2e": "bun run build && playwright test",
        "test:all": "bun run test:unit && composer test && bun run test:e2e"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "concurrently": "^9.2.5",
        "jsdom": "^30.1.3",
        "tailwindcss": "^4.3.3",
        "vite": "^6.4.5",
        "vitest": "^5.0.5"
    },
    "dependencies": {
        "@askjo/camofox-browser": "^1.18.1",
        "chart.js": "^4.6.1",
        "chartjs-adapter-date-fns": "^3.0.0",
        "playwright": "^1.64.1",
        "puppeteer": "^25.16.0",
        "puppeteer-extra": "^3.3.6",
        "puppeteer-extra-plugin-stealth": "^2.11.2"
    }
}
