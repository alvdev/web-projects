#!/usr/bin/env bash
# diario.games pre-push hook: run the fast regression suite before pushing.
#
# Install (from diario.games/):
#   ln -sf ../../diario.games/scripts/git-hooks/pre-push ../.git/hooks/pre-push
#
# Bypass a single run with: git push --no-verify
set -u

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
PROJECT="$ROOT/diario.games"

if [ -z "$ROOT" ] || [ ! -d "$PROJECT" ]; then
    exit 0
fi

# This repository is a monorepo: only run the suite when the pushed refs touch
# diario.games. Manual invocations (no refs on stdin) always run it.
saw_ref=0
run=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ -n "${local_sha:-}" ] || continue
    saw_ref=1

    case "$local_sha" in
        0000000000000000000000000000000000000000) continue ;;
    esac

    if [ -z "${remote_sha:-}" ] || [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        run=1
        break
    fi

    if git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null | grep -q '^diario.games/'; then
        run=1
        break
    fi
done

if [ "$saw_ref" -eq 0 ]; then
    run=1
fi

if [ "$run" -eq 0 ]; then
    echo "pre-push: no diario.games changes in this push; skipping tests."
    exit 0
fi

cd "$PROJECT" || exit 0

echo "pre-push: running diario.games fast suite (bypass with: git push --no-verify)"

if ! composer test; then
    echo "pre-push: PHP suite failed — push aborted." >&2
    exit 1
fi

if ! bun run test:unit; then
    echo "pre-push: JS suite failed — push aborted." >&2
    exit 1
fi

echo "pre-push: fast suite passed."
exit 0
