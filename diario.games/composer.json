{
    "name": "diario/games",
    "require": {
        "php": ">=8.1",
        "getkirby/cms": "^5.0",
        "arnoson/kirby-loupe": "^0.4",
        "arnoson/kirby-vite": "^5.0",
        "tearoom1/kirby-meta-kit": "^2.0",
        "bnomei/kirby3-feed": "^5.0",
        "bnomei/kirby3-dotenv": "^5.1"
    },
    "extra": {
        "kirby-plugin-loader": true
    },
    "config": {
        "allow-plugins": {
            "getkirby/composer-installer": true
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/Support/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit"
    }
}
