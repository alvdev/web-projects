IGDB_CLIENT_ID=your_twitch_client_id
IGDB_CLIENT_SECRET=your_twitch_client_secret
OPENROUTER_API_KEY=sk-or-v1-...
OPENCODE_API_KEY=sk-...
STEAM_STATS_API_KEY=
STEAM_STATS_WARM_KEY=choose_a_secret_key
# Optional: falls back to STEAM_STATS_WARM_KEY when unset
TWITCH_STATS_WARM_KEY=
# Optional: override the Twitch stats SQLite location
TWITCH_STATS_DB_PATH=
# G2A price provider: enable only after receiving valid G2A credentials
G2A_ENABLED=false
