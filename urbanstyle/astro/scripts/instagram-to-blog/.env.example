# Instagram Graph API credentials
IG_ACCESS_TOKEN=IGAA...
IG_APP_ID=...
IG_APP_SECRET=...
# Stop post ID: processing walks newest-first from the API and stops AT this post
# (the stop post itself is excluded). Set to the post right before the oldest
# post you want published. Production: Post Malone post (2025-02-25) -> backlog
# starts at DGlSRwyK6Dn (2025-02-27) and runs through the newest post.
IG_STOP_POST_ID=18032403803293824
# First-run stop ID: fallback boundary when no state file exists yet.
IG_FIRST_RUN_STOP_ID=18032403803293824

# LLM provider (opencode-go, OpenAI-compatible endpoint)
OPENCODE_API_KEY=sk-...
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=deepseek-v4-flash

# LLM provider (Google Gemini — primary)
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-3.6-flash
# Model chain (priority order). On 429 (quota) the next model is used; on 503 the same model is retried.
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash
# Max minutes to keep polling every 5 min when Gemini is 503 (high demand) before aborting

# SMTP for alert emails
SMTP_HOST=mail.domain.com
SMTP_PORT=465
SMTP_USER=mail@domain.com
SMTP_PASSWORD=...
ALERT_EMAIL=recipient@domain.com

# FTPS deployment (diff-based sync of dist/)
FTP_HOST=ftp.domain.com
FTP_USER=alvdev
FTP_PASSWORD=...
FTP_REMOTE_PATH=/domain.com

# Set true to skip all writes/builds/deploys (log-only mode)
DRY_RUN=false
# Set true to write posts but skip build + FTP upload (for testing)
SKIP_DEPLOY=false
# Max posts queued per run
MAX_POSTS_PER_RUN=1
# Node bin dir used for astro build (requires >=18.20.8)
NODE_BIN_DIR=/path/to/node/bin

# Telegram approval bot (create via @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABC...
TELEGRAM_CHAT_ID=...

# X/Twitter via Buffer API (key from https://publish.buffer.com/settings/api)
BUFFER_ACCESS_TOKEN=...
BUFFER_ORGANIZATION_ID=...   # optional; auto-discovered if empty

# Google Business Profile via Buffer API — SEPARATE Buffer workspace/key from
# the X one above (GBP channel connected there, service: googlebusiness).
# LinkedIn (service: linkedin, page "urban-style-publicity") uses the SAME
# workspace/key as GBP.
GBP_BUFFER_ACCESS_TOKEN=...
GBP_BUFFER_ORGANIZATION_ID=...   # optional; auto-discovered if empty

# Facebook direct posting via Graph API (own Meta app + page token) — link preview
# + API deletion. Falls back to Buffer if unset. Real page mentions are NOT
# possible via any API path (Facebook restricts them to its composer).
# Steps: developers.facebook.com → app → Graph API Explorer → user token
# (pages_show_list, pages_manage_posts, pages_read_engagement) → Extend →
# GET /me/accounts → copy page access_token (long-lived, does not expire).
FB_PAGE_ID=...
FB_ACCESS_TOKEN=...
FB_APP_ID=...
FB_APP_SECRET=...

# Optional proxy (e.g. PacketStream residential) — used ONLY as the last web-search
# fallback (Brave HTML) when direct Bing/DuckDuckGo fail.
WEBSEARCH_PROXY=http://user:pass@host:port
