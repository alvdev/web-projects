[Unit]
Description=Urban Style Telegram approval bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/alvdev/dev/www/web-projects/urbanstyle/astro
Environment=PATH=/home/alvdev/.nvm/versions/node/v22.23.2/bin:/home/alvdev/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/alvdev/.bun/bin/bun run scripts/instagram-to-blog/bot.ts
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
