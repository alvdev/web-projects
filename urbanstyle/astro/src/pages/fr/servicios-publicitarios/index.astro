---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Base from "@/layouts/Base.astro";
import Dossier from "@/components/banners/Dossier.astro";
import Header from "@/components/Header.astro";
import headerImg from "@/content/services/tu-publicidad-aqui.webp";
import Hdivider from "@/assets/images/h-divider.svg";
import { entryMatchesLocale, useTranslations, type Locale } from "@/i18n/ui";

const locale = (Astro.currentLocale ?? "es") as Locale;
const t = useTranslations(locale);
const pathPrefix = import.meta.env.BASE_URL + (locale === "es" ? "" : `${locale}/`);
const services = (await getCollection("services")).filter(e => entryMatchesLocale(e, locale));
const serviceSlugs = services
    .sort((a, b) => a.data.order - b.data.order)
    .map(page => page.data.slug || String(page.id).split("/").pop());

const whatWeOffer = [
    "Nous sommes experts pour diffuser votre publicité dans toutes les villes et tous les lieux de la géographie espagnole.",
    "Nous disposons d'une infrastructure de design, de production et de distribution qui garantit les meilleurs résultats.",
    "Nous ne nous limitons pas à distribuer vos annonces : nous nous efforçons aussi de favoriser une interaction significative avec votre audience.",
    "Nous gérons toutes les autorisations municipales nécessaires pour que vous puissiez vous concentrer sur l'essentiel : votre activité.",
    "Nous employons des stratégies émotionnelles et créatives qui captent l'attention du public et créent une connexion authentique avec votre marque.",
    "Des touches d'humour aux tactiques d'engagement innovantes, nous veillons à ce que votre campagne soit mémorable et efficace à chaque étape."
];

const title = "Services <br>publicitaires";
const dossierTitle = "Vous pouvez dès maintenant télécharger notre catalogue complet de services";
const pageTitle = "Services publicitaires | Urban Style Publicity";
const pageDescription =
    "Nous sommes experts pour diffuser votre message dans toutes les villes et tous les lieux. Nous gérons les autorisations nécessaires pour promouvoir votre campagne publicitaire ou votre événement.";
---

<Base
    title={pageTitle}
    description={pageDescription}
    cover={headerImg}
>
    <Header title={title} cover={headerImg} classes="h-[75vh]" />

    <main class="relative z-10 pb-6">
        <section class="container mt-24 pb-28">
            <ul
                class="p-0 m-0 columns-1 lg:columns-2 *:break-inside-avoid-column gap-4 space-y-4 lg:gap-8 lg:space-y-8 text-pretty"
            >
                {
                    whatWeOffer.map(item => (
                        <li class="lg:mt-7 flex flex-col px-10 py-8 bg-white border-2 border-gray-300 leading-relaxed text-xl text-balance rounded shadow-md h-fit -rotate-1">
                            {item}
                        </li>
                    ))
                }
            </ul>
        </section>

        <Hdivider />

        <div class="container mt-24">
            <div class="flex flex-col-reverse gap-28 mt-28 xl:flex-row">
                <div>
                    {
                        [...services]
                            .sort((a, b) => a.data.order - b.data.order)
                            .map((page, index) => {
                                const reverseStyles =
                                    index % 2 === 0
                                        ? "[&_h2]:right-0 [&_h2]:text-right **:[div.btnContainer]:after:right-0"
                                        : "lg:text-right lg:flex-row-reverse [&_h2]:left-0 [&_h2]:text-left **:[a]:ml-auto";
                                const reverseGradient = index % 2 === 0 ? "bg-gradient-to-l" : "bg-gradient-to-r";

                                return (
                                    <div
                                        class={`relative flex flex-col justify-between gap-4 mt-24 first:mt-0 lg:flex-row lg:gap-16 ${reverseStyles}`}
                                    >
                                        <div class="relative border-2 border-black overflow-clip rounded-sm shadow-xl lg:w-1/2 aspect-video">
                                            <a href={pathPrefix + serviceSlugs[index]} class="group +++">
                                                <Image
                                                    src={page.data.cover}
                                                    class="m-0 aspect-video w-full h-full! group-hover:scale-105 transition-all duration-700"
                                                    alt={page.data.title}
                                                    width={475}
                                                    height={300}
                                                    format="webp"
                                                />

                                                <h2
                                                    class={`absolute max-w-11/12 bottom-0 m-0 uppercase font-bold text-white text-shadow-xs text-shadow-black text-4xl ${reverseGradient}`}
                                                >
                                                    <span class="box-decoration-clone bg-black/70 px-3 pt-0 pb-1 leading-normal">
                                                        {page.data.shortTitle || page.data.title}
                                                    </span>
                                                </h2>
                                            </a>
                                        </div>

                                        <div class="btnContainer relative p-2 grid  gap-8 lg:p-0 lg:w-1/2 text-gray-800 text-2xl [&>*]:text-balance [&>p:first-child]:mt-0 text-balance leading-normal after:absolute after:w-[calc(100%-4rem)] after:h-0.5 after:bg-black after:bottom-7 after:-z-10">
                                            <p>{page.data.description}</p>
                                            <a
                                                class="btn w-fit h-fit self-end text-lg mb-1 px-6 py-3 shadow-gray-400"
                                                href={pathPrefix + serviceSlugs[index]}
                                            >
                                                {t("services.view")}
                                            </a>
                                        </div>
                                    </div>
                                );
                            })
                    }
                </div>

                <aside>
                    <div class="xl:sticky xl:top-24">
                        <div
                            class="flex flex-col md:flex-row text-center items-stretch gap-8 text-balance md:gap-16 xl:flex-col xl:gap-8"
                        >
                            <Dossier
                                title={dossierTitle}
                                classes="mt-8"
                            />
                        </div>
                    </div>
                </aside>
            </div>
        </div>
    </main>
</Base>