---
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import logo from "../assets/images/logo-urban-250.webp";
import LanguageSelector from "@/components/LanguageSelector.astro";
import { useTranslations, coverageSlugs, type Locale } from "@/i18n/ui";

const locale = (Astro.currentLocale ?? "es") as Locale;
const t = useTranslations(locale);

const link = {
    home: getRelativeLocaleUrl(locale, ""),
    posters: getRelativeLocaleUrl(locale, coverageSlugs[locale]),
    services: getRelativeLocaleUrl(locale, "servicios-publicitarios"),
    jobs: getRelativeLocaleUrl(locale, "trabajos"),
    agency: getRelativeLocaleUrl(locale, "agencia-publicidad-exterior"),
    blog: getRelativeLocaleUrl(locale, "blog"),
    contact: getRelativeLocaleUrl(locale, "contacto"),
};
---

<nav
    x-data="{ mobileNavOpen: false, scrollNav: false }"
    class="relative z-30"
    x-intersect:enter.maring.100px="scrollNav = true"
    x-intersect:leave="scrollNav = false"
>
    <div
        class="container max-w-none fixed w-[94%] lg:w-[86%] left-0 right-0 top-8 mx-auto flex items-center justify-between gap-4 pl-2 pr-6 py-2 bg-white/90 backdrop-blur-md rounded-full border shadow-xl transition-all"
        :class="{ 'top-8 pl-2 pr-6 py-2': scrollNav, 'top-2 pl-1 pr-3 py-1': !scrollNav }"
    >
        <div
            class="w-36 flex flex-wrap items-center transition-all"
            :class="{'w-36 min-w-36': scrollNav, 'w-24 min-w-24': !scrollNav}"
        >
            <a href={link.home}>
                <Image src={logo} alt="Logo Urban" width={250} height={146} format="webp" />
            </a>
        </div>

        <div class="flex flex-wrap items-center flex-1">
            <div class="w-full hidden lg:block">
                <ul
                    class="text-center flex flex-wrap items-center justify-center gap-x-4 w-fit mx-auto uppercase *:transition-all **:[a]:relative **:[a>span]:absolute **:[a>span]:-z-10 **:[a>span]:[text-shadow:1px_1px_black] **:[a>span]:block **:[a>span]:bg-red-800 **:[a>span]:text-white **:[a>span]:font-normal **:[a>span]:normal-case **:[a>span]:px-1 **:[a>span]:pb-0.5 **:[a>span]:text-xs *:grow-0 *:shrink-0 **:[a]:w-fit lg:grid lg:grid-cols-3 lg:**:[a]:mx-auto xl:*:basis-auto xl:**:[a]:px-3 2xl:flex *:w-fit *:mx-auto"
                >
                    <li class="hover:scale-105">
                        <a href={link.home} class="text-black font-bold px-4 py-3 hover:text-red-800">{t("nav.home")}</a>
                    </li>
                    <li class="hover:scale-105">
                        <a href={link.posters} class="block text-black font-bold px-4 py-3 hover:text-red-800">
                            <span class="top-0.5">{t("nav.postersTop")}</span>
                            {t("nav.postersBottom")}
                        </a>
                    </li>
                    <li class="hover:scale-105">
                        <a href={link.services} class="block text-black font-bold px-4 py-3 hover:text-red-800">
                            {t("nav.servicesTop")}
                            <span class="right-0 bottom-0">{t("nav.servicesBottom")}</span>
                        </a>
                    </li>
                    <li class="hover:scale-105">
                        <a href={link.jobs} class="text-black font-bold px-4 py-3 hover:text-red-800">{t("nav.jobs")}</a>
                    </li>
                    <li class="hover:scale-105">
                        <a href={link.agency} class="text-black font-bold px-4 py-3 hover:text-red-800">{t("nav.agency")}</a>
                    </li>
                    <li class="hover:scale-105">
                        <a href={link.blog} class="text-black font-bold px-4 py-3 hover:text-red-800">{t("nav.blog")}</a>
                    </li>
                </ul>
            </div>
        </div>

        <div class="flex items-center justify-end gap-2">
            <div class="hidden lg:block">
                <LanguageSelector variant="desktop" />
            </div>
            <div class="w-auto hidden lg:block">
                <div class="inline-block">
                    <a
                        href={link.contact}
                        class="py-3 px-5 w-full font-semibold uppercase hover:border-gray-300 rounded-full focus:ring focus:ring-gray-50 bg-black text-white hover:ring-3 hover:ring-black transition ease-in-out duration-200"
                        type="button"
                        :class="{ 'py-3': scrollNav, 'py-2': !scrollNav }"
                    >
                        {t("nav.contact")}
                    </a>
                </div>
            </div>
            <div class="flex items-center lg:hidden">
                <button x-on:click="mobileNavOpen = !mobileNavOpen" aria-label={t("nav.openMenu")}>
                    <svg
                        class="text-red-black"
                        width="51"
                        height="51"
                        viewBox="0 0 56 56"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <rect width="56" height="56" rx="28" fill="currentColor"></rect>
                        <path
                            d="M37 32H19M37 24H19"
                            stroke="white"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                        </path>
                    </svg>
                </button>
            </div>
        </div>
    </div>

    <div
        :class="{'block': mobileNavOpen, 'hidden': !mobileNavOpen}"
        class="fixed top-0 left-0 bottom-0 w-4/6 sm:max-w-xs z-50 hidden min-h-screen"
    >
        <div
            x-on:click="mobileNavOpen = !mobileNavOpen"
            class="fixed inset-0 min-h-screen bg-gray-800 opacity-80 backdrop-blur-2xl"
        >
        </div>
        <nav class="relative flex z-10 px-9 bg-black min-h-screen transition-all">
            <div class="flex flex-wrap justify-center self-center h-10/12">
                <button
                    class="absolute -right-24 bottom-1/2 bg-black flex items-center justify-center rounded-full w-14 h-14"
                    x-on:click="mobileNavOpen = !mobileNavOpen"
                    aria-label={t("nav.closeMenu")}
                >
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path
                            d="M6 18L18 6M6 6L18 18"
                            stroke="white"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                        </path>
                    </svg>
                </button>

                <div class="flex items-center justify-between w-36">
                    <a class="inline-block" href={link.home}>
                        <Image
                            src={logo}
                            class="w-full [filter:grayscale(1)_drop-shadow(0px_0px_1px_white)_drop-shadow(0px_0px_1px_white)_drop-shadow(0px_0px_1px_white)_drop-shadow(0px_0px_1px_white)_drop-shadow(0px_0px_1px_white)]"
                            alt="Logo Urban"
                            width={250}
                            height={146}
                            format="webp"
                        />
                    </a>
                </div>
                <ul
                    class="flex flex-col gap-0 justify-center pt-16 pb-8 w-full text-center uppercase **:[a]:relative **:[a]:text-white **:[a]:hover:text-red-800 **:[a>span]:absolute **:[a>span]:-z-10 **:[a>span]:[text-shadow:1px_1px_black] **:[a>span]:w-fit **:[a>span]:mx-auto **:[a>span]:block **:[a>span]:bg-red-800 **:[a>span]:text-white **:[a>span]:font-normal **:[a>span]:normal-case **:[a>span]:px-1 **:[a>span]:pb-0.5 **:[a>span]:text-xs"
                >
                    <li>
                        <a class="font-medium block p-4 py-6" href={link.posters}>
                            <span class="top-2.5 left-0 right-1/4">{t("nav.postersTop")}</span>
                            {t("nav.postersBottom")}
                        </a>
                    </li>
                    <li>
                        <a class="font-medium block p-4 py-6" href={link.services}>
                            {t("nav.servicesTop")}
                            <span class="bottom-2.5 left-1/4 right-0">{t("nav.servicesBottom")}</span>
                        </a>
                    </li>
                    <li>
                        <a class="font-medium block p-4 py-6" href={link.jobs}>{t("nav.jobs")}</a>
                    </li>
                    <li>
                        <a class="font-medium block p-4 py-6" href={link.agency}>{t("nav.agency")}</a>
                    </li>
                    <li>
                        <a class="font-medium block p-4 py-6" href={link.blog}>{t("nav.blog")}</a>
                    </li>
                </ul>
                <div class="flex flex-col justify-end w-full gap-4">
                    <LanguageSelector variant="mobile" classes="mx-auto" />
                    <a
                        href={link.contact}
                        class="py-3 px-5 w-full font-semibold uppercase rounded-full focus:ring-4 focus:ring-white bg-white text-black text-center hover:ring-4 hover:ring-white hover:transition-all transition-all"
                    >
                        {t("nav.contact")}
                    </a>
                </div>
            </div>
        </nav>
    </div>
</nav>
