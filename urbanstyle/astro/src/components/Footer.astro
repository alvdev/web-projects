---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getFilename } from "@/utils/getFilename";
import LandPhoneIcon from "@/assets/icons/landphone.svg";
import { Image } from "astro:assets";
import footerImg from "../assets/images/ciudad-footer.webp";
import { getLocalizedCollection, useTranslations, type Locale } from "@/i18n/ui";

const locale = (Astro.currentLocale ?? "es") as Locale;
const t = useTranslations(locale);

const services = await getLocalizedCollection("services", locale);
const legalPages = Object.values(import.meta.glob("@/pages/legal/*.astro", { eager: true }));
const slogan =
    Astro.url.pathname === import.meta.env.BASE_URL ? t("footer.sloganHome") : t("footer.slogan");
const latestJsonUrl =
    import.meta.env.BASE_URL + (locale === "es" ? "" : `${locale}/`) + "blog/latest.json";
---

<footer class="relative z-20 **:hover:[a]:text-white">
    <Image src={footerImg} alt={t("footer.footerAlt")} />
    <div class="flex flex-col gap-8 pt-16 pb-24 text-base text-gray-200 bg-black">
        <div class="md:px-8 overflow-x-clip mask-x-from-70%">
            <div
                class="animate-infinite-scroll-l w-max mx-auto text-center [animation-duration:40s] whitespace-nowrap font-black md:font-bold text-5xl md:text-8xl uppercase text-red-800/60 flex gap-4 md:pr-4"
            >
                <div>{slogan}</div>
                <div aria-hidden>{slogan}</div>
            </div>
        </div>

        <div
            class="container mt-8 md:mt-12 flex flex-col justify-between gap-20 **:[h3]:font-semibold lg:flex-row *:lg:w-1/3 *:xl:w-auto"
        >
            <div>
                <h3 class="text-3xl text-gray-200">{t("footer.services")}</h3>

                <ul class="gap-12 mt-8 columns-2">
                    {
                        [...services]
                            .sort((a, b) =>
                                (a.data.shortTitle || a.data.title).localeCompare(b.data.shortTitle || b.data.title),
                            )
                            .map(service => {
                                const slug = service.data.slug || String(service.id).split("/").pop();
                                const href =
                                    slug === "./" || slug === "."
                                        ? getRelativeLocaleUrl(locale, "")
                                        : getRelativeLocaleUrl(locale, slug);
                                return (
                                    <li class="mb-5">
                                        <a href={href}>
                                            {service.data.shortTitle || service.data.title}
                                        </a>
                                    </li>
                                );
                            })
                    }
                </ul>
            </div>

            <div>
                <h3 class="text-3xl text-gray-200">{t("footer.latest")}</h3>

                <div id="latest-posts" class="flex flex-col gap-4 mt-8" data-json={latestJsonUrl}>
                    <!-- Rendered client-side from the locale's /blog/latest.json so the footer
                         stays static across the site (only the JSON changes on publish) -->
                </div>

                <script>
                    async function loadLatestPosts() {
                        const container = document.getElementById("latest-posts");
                        if (!container || container.dataset.loaded) return;
                        try {
                            const res = await fetch(container.dataset.json || "");
                            if (!res.ok) return;
                            const posts = await res.json();
                            container.dataset.loaded = "1";
                            container.innerHTML = posts
                                .map(
                                    (post: { url: string; title: string }) => `
                                        <article class="flex flex-col gap-4">
                                            <div class="text-lg text-gray-500">
                                                <h4 class="p-0 pb-1 my-0 text-base text-balance md:line-clamp-2">
                                                    <a href="${post.url}" class="text-pretty inline-block leading-relaxed">${post.title}</a>
                                                </h4>
                                            </div>
                                        </article>`,
                                )
                                .join("");
                        } catch {
                            // keep the section empty if the request fails
                        }
                    }
                    loadLatestPosts();
                </script>
            </div>

            <div class="flex flex-col self-stretch justify-between">
                <div>
                    <h3 class="flex items-center gap-2 text-3xl text-gray-200">
                        <a
                            href="tel:+34913052922"
                            title={t("footer.phoneTitle")}
                            class="leading-none text-white opacity-100 font-semibold hover:opacity-80"
                        >
                            91 305 29 22
                        </a>
                        <LandPhoneIcon class="w-7 h-7 self-end -rotate-90" />
                    </h3>

                    <address class="mt-4">
                        <a href="https://maps.app.goo.gl/DiryCTKNXY3yaZAs8" target="_blank">
                            Av del Manzanares, 202
                            <br />
                            28026, Madrid, España
                        </a>
                    </address>
                </div>

                <div class="mt-8">
                    <h3 class="text-3xl text-gray-200">{t("footer.social")}</h3>
                    <ul class="flex items-center flex-wrap gap-4 mt-4">
                        <li>
                            <a
                                href="https://instagram.com/urban_style_publicity"
                                target="_blank"
                                title={t("footer.igTitle")}
                            >
                                Instagram
                            </a>
                        </li>
                        <li>
                            <a
                                href="https://www.facebook.com/profile.php?id=61557928546519"
                                target="_blank"
                                title={t("footer.fbTitle")}
                            >
                                Facebook
                            </a>
                        </li>
                        <li>
                            <a
                                href="https://twitter.com/pegadacarteles"
                                target="_blank"
                                title={t("footer.twTitle")}
                            >
                                Twitter
                            </a>
                        </li>
                        <li>
                            <a
                                href="https://www.linkedin.com/in/pedro-jim%C3%A9nez-39671b124/"
                                target="_blank"
                                title={t("footer.liTitle")}
                            >
                                LinkedIn
                            </a>
                        </li>
                        <li>
                            <a
                                href="https://youtube.com/@pegadadecarteles"
                                target="_blank"
                                title={t("footer.ytTitle")}
                            >
                                Youtube
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="flex flex-col gap-4 mt-8">
                    <div>
                        © 2016 - {new Date().getFullYear()} Urban Style Publicity, S.L.
                    </div>
                    <div class="flex flex-wrap gap-x-8 gap-y-4">
                        {
                            legalPages.map(page => {
                                const legalPage = page as { url: string; anchorText?: string; file: string };
                                return (
                                    <a href={legalPage.url}>{legalPage.anchorText || getFilename(legalPage.file)}</a>
                                );
                            })
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</footer>